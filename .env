# Default settings for every environment. This file is committed, so it holds no secrets.
# Vite puts every VITE_ variable into the browser bundle, where anyone can read it.
#
# Override a value locally in .env.local (not committed). In CI/CD, set the variable in
# the build environment: environment variables win over these files.

# Base URL the app calls the API on, without a trailing slash.
# Locally /api, which the Vite dev server proxies to the Go API.
# For dev and prod, the CD workflow sets the API's absolute URL, for example
# https://<api-app>.azurewebsites.net, when it builds the app.
VITE_API_BASE_URL=/api

# Where the Vite dev server and `vite preview` send /api requests. The /api prefix is
# removed, so /api/objectives goes to http://localhost:8080/objectives.
# Not used in the built app.
VITE_API_PROXY_TARGET=http://localhost:8080
